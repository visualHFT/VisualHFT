<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('windows'))">net10.0</TargetFramework>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0;net10.0-windows10.0.17763.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-windows'))">8.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="kraken_JsonMessages\PrivateMessages_Scenario9.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="kraken_JsonMessages\PrivateMessages_Scenario8.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="kraken_JsonMessages\PrivateMessages_Scenario7.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="kraken_JsonMessages\PrivateMessages_Scenario6.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="kraken_JsonMessages\PrivateMessages_Scenario5.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="kraken_JsonMessages\PrivateMessages_Scenario4.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="kraken_JsonMessages\PrivateMessages_Scenario3.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="kraken_JsonMessages\PrivateMessages_Scenario2.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="kraken_JsonMessages\PrivateMessages_Scenario1.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="KrakenExchange.Net" Version="8.5.0" />
    <PackageReference Include="log4net" Version="3.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\VisualHFT.Commons\VisualHFT.Commons.csproj" />
  </ItemGroup>


  <PropertyGroup>
    <UseWPF Condition="$(TargetFramework.Contains('-windows'))">true</UseWPF>
    <DefineConstants Condition="$(TargetFramework.Contains('-windows'))">$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="!$(TargetFramework.Contains('-windows'))">
    <Compile Remove="UserControls\**\*.cs" />
    <Compile Remove="ViewModels\**\*.cs" />
    <Compile Remove="ViewModel\**\*.cs" />
    <Page Remove="**\*.xaml" />
  </ItemGroup>

</Project>
