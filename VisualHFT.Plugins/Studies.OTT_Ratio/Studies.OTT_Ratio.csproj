<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('windows'))">net10.0</TargetFramework>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0;net10.0-windows10.0.17763.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-windows'))">8.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\VisualHFT.Commons.WPF\VisualHFT.Commons.WPF.csproj" Condition="$(TargetFramework.Contains('-windows'))" />
    <ProjectReference Include="..\..\VisualHFT.Commons\VisualHFT.Commons.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="UserControls\PluginSettingsView.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>


  <PropertyGroup>
    <UseWPF Condition="$(TargetFramework.Contains('-windows'))">true</UseWPF>
    <DefineConstants Condition="$(TargetFramework.Contains('-windows'))">$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="!$(TargetFramework.Contains('-windows'))">
    <Compile Remove="UserControls\**\*.cs" />
    <Compile Remove="ViewModels\**\*.cs" />
    <Compile Remove="ViewModel\**\*.cs" />
    <Page Remove="**\*.xaml" />
  </ItemGroup>

</Project>
