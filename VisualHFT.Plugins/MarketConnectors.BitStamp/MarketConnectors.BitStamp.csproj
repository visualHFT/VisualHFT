<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('windows'))">net10.0</TargetFramework>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0;net10.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\log4net.config" Link="log4net.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CryptoExchange.Net" Version="13.0.0" />
    <PackageReference Include="Websocket.Client" Version="5.5.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\VisualHFT.Commons\VisualHFT.Commons.csproj" />
    <ProjectReference Include="..\MarketConnectors.BaseDAL\BitStamp.Net\BitStamp.Net.csproj" />
  </ItemGroup>


  <PropertyGroup>
    <UseWPF Condition="$(TargetFramework.Contains('-windows'))">true</UseWPF>
    <DefineConstants Condition="$(TargetFramework.Contains('-windows'))">$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="!$(TargetFramework.Contains('-windows'))">
    <Compile Remove="UserControls\**\*.cs" />
    <Compile Remove="ViewModels\**\*.cs" />
    <Compile Remove="ViewModel\**\*.cs" />
    <Page Remove="**\*.xaml" />
  </ItemGroup>

</Project>
