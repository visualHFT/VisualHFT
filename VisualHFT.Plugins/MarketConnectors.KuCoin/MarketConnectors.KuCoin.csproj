<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('windows'))">net10.0</TargetFramework>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0;net10.0-windows10.0.17763.0</TargetFrameworks>
	  <Nullable>enable</Nullable>
	  <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-windows'))">8.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="kucoin_jsonMessages\PrivateMessages_Scenario1.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="kucoin_jsonMessages\PrivateMessages_Scenario3.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="kucoin_jsonMessages\PrivateMessages_Scenario4.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="kucoin_jsonMessages\PrivateMessages_Scenario5.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="kucoin_jsonMessages\PrivateMessages_Scenario6.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="kucoin_jsonMessages\PrivateMessages_Scenario7.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="kucoin_jsonMessages\PrivateMessages_Scenario8.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="kucoin_jsonMessages\PrivateMessages_Scenario9.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="kucoin_jsonMessages\PrivateMessages_Scenario2.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="kucoin_jsonMessages\PrivateMessages_Scenario1.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\log4net.config" Link="log4net.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Kucoin.Net" Version="9.6.0" />
    <PackageReference Include="log4net" Version="3.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\VisualHFT.Commons\VisualHFT.Commons.csproj" />
  </ItemGroup>


  <PropertyGroup>
    <UseWPF Condition="$(TargetFramework.Contains('-windows'))">true</UseWPF>
    <DefineConstants Condition="$(TargetFramework.Contains('-windows'))">$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="!$(TargetFramework.Contains('-windows'))">
    <Compile Remove="UserControls\**\*.cs" />
    <Compile Remove="ViewModels\**\*.cs" />
    <Compile Remove="ViewModel\**\*.cs" />
    <Page Remove="**\*.xaml" />
  </ItemGroup>

</Project>
